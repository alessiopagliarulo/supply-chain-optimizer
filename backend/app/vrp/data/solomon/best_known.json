  "_comment": "Published reference values for the Solomon (1987) VRPTW instances, transcribed by parsing the source tables below (not typed by hand). Values are stored exactly as published. null means the source lists no optimum for that case.",
  "sources": {
    "sintef_best_known": {
      "title": "SINTEF TOP, Solomon benchmark, 100 customers: best known solutions",
      "url": "https://www.sintef.no/projectweb/top/vrptw/100-customers/",
      "retrieved": "2026-09-18",
      "applies_to": [
        100
      ],
      "objective": "hierarchical: 1) minimize number of vehicles, 2) minimize total distance",
      "ranks_vehicles_first": true,
      "distance_convention": "Euclidean distance and time in double precision; total distance rounded to two decimals",
      "notes": "r111 is quoted by SINTEF as 1096.73* (checker value 1096.72658305008); r205 and rc101 carry SINTEF's footnote that earlier values 994.42 / 1696.94 came from a rounding error."
    },
    "solomon_optimal": {
      "title": "M. M. Solomon, Optimal Solutions for C1/C2, R1/R2 and RC1/RC2 problems (last updated 2005-03-24)",
      "url": [
        "http://web.cba.neu.edu/~msolomon/c1c2solu.htm",
        "http://web.cba.neu.edu/~msolomon/r1r2solu.htm",
        "http://web.cba.neu.edu/~msolomon/rc12solu.htm"
      ],
      "archived_copies": [
        "https://web.archive.org/web/20210731183659/http://web.cba.neu.edu/~msolomon/c1c2solu.htm",
        "https://web.archive.org/web/20210731193817/http://web.cba.neu.edu/~msolomon/r1r2solu.htm",
        "https://web.archive.org/web/20210731183114/http://web.cba.neu.edu/~msolomon/rc12solu.htm"
      ],
      "retrieved": "2026-09-18",
      "applies_to": [
        25,
        50
      ],
      "objective": "minimize total distance (vehicle count is whatever the optimal routes use)",
      "ranks_vehicles_first": false,
      "distance_convention": "exact-method convention: each arc's Euclidean distance (and travel time) truncated to one decimal. Checked here: CP-SAT with truncated one-decimal arithmetic reproduces the published optima (e.g. C101.25 = 191.3, R101.25 = 617.1, RC101.25 = 461.1)."
    }
